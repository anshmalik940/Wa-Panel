{
  "name": "wa-panel-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant WhatsApp campaign panel API (admin / reseller / customer)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/scripts/seed.js",
    "seed:demo": "node src/scripts/seed.js --demo",
    "admin:reset-credentials": "node scripts/reset-admin-credentials.js",
    "lint": "eslint src tests",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "supertest": "^7.3.1"
  },
  "optionalDependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14"
  }
}
