# ---- Required ----
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/wa_panel
# At least 32 characters each. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-change-me-change-me-change-me-0000
ENCRYPTION_KEY=change-me-change-me-change-me-change-me-1111

# ---- First admin (created on first start if no admin exists) ----
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-initial-password

# ---- URLs ----
# Local development. On Render, set CLIENT_URL to exactly https://wa-panel-five.vercel.app.
CLIENT_URL=http://localhost:5173
# Public URL of this API (shown as the webhook URL in WhatsApp settings)
PUBLIC_API_URL=http://localhost:5000

# ---- Behaviour ----
JWT_EXPIRES_IN=12h
DEFAULT_COUNTRY_CODE=91
BCRYPT_ROUNDS=10
# Master switch for REAL sending (linked phone via QR, Meta Cloud API, voice API). The mock provider always works.
# Set to false to block every real message/call (safe test mode).
ALLOW_REAL_SEND=true
# Mock-only campaigns default on outside production and off in production.
# ALLOW_MOCK_CAMPAIGNS=true
# Where uploaded images/videos/documents and linked-phone (QR) sessions are stored. Keep this folder across restarts.
# DATA_DIR=./data
WHATSAPP_GRAPH_VERSION=v21.0
# Queue worker (runs inside the API process)
WORKER_ENABLED=true
WORKER_INTERVAL_MS=1000
WORKER_BATCH_SIZE=20
# Password reset: link is printed to the server console (and returned by the API in development).
RESET_TOKEN_TTL_MIN=30
# RESET_RETURN_LINK=true   # defaults to true in development, false in production
# Set to 1 when running behind one reverse proxy (nginx, Render, Railway...)
TRUST_PROXY=0

# ---- Optional SMTP for password reset emails ----
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="WA Panel <no-reply@example.com>"

# If you see "querySrv ECONNREFUSED" with a mongodb+srv:// URI, uncomment:
# DNS_SERVERS=8.8.8.8,8.8.4.4
